{
    "manifest_version":  3,
    "name":  "Liquid Keys",
    "version":  "0.1.2",
    "description":  "Passkeys kept by Liquid on this PC. You sign in by looking at the camera.",
    "key":  "",
    "permissions":  [
                        "nativeMessaging"
                    ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://*/*",
                                                "http://localhost/*"
                                            ],
                                "js":  [
                                           "page.js"
                                       ],
                                "world":  "MAIN",
                                "run_at":  "document_start",
                                "all_frames":  true
                            },
                            {
                                "matches":  [
                                                "https://*/*",
                                                "http://localhost/*"
                                            ],
                                "js":  [
                                           "bridge.js"
                                       ],
                                "run_at":  "document_start",
                                "all_frames":  true
                            }
                        ],
    "host_permissions":  [
                             "http://127.0.0.1/*"
                         ]
}